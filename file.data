sudo apt update
   2     sudo apt install nginx

   2. Create a configuration file:
      /etc/nginx/sites-available/festpanel.pl

    1     server {
    2         listen 80;
    3         server_name festpanel.pl www.festpanel.pl;
    4
    5         location / {
    6             proxy_pass http://localhost:3000;
    7             proxy_http_version 1.1;
    8             proxy_set_header Upgrade
      $http_upgrade;
    9             proxy_set_header Connection 'upgrade';
   10             proxy_set_header Host $host;
   11             proxy_cache_bypass $http_upgrade;
   12         }
   13     }

   3. Enable the configuration:

   1     sudo ln -s
     /etc/nginx/sites-available/festpanel.pl
     /etc/nginx/sites-enabled/
   2     sudo nginx -t  # Check for syntax errors
   3     sudo systemctl restart nginx

   4. SSL/HTTPS (Recommended):
      Use Certbot (https://certbot.eff.org/) to
  automatically obtain and configure Let's Encrypt
  certificates for HTTPS:

   1     sudo apt install certbot python3-certbot-nginx
   2     sudo certbot --nginx -d festpanel.pl -d
     www.festpanel.pl

