{
  "name": "festpanel",
  "version": "1.0.0",
  "private": true,
  "description": "FestPanel - Profesjonalny Montaż Paneli Podłogowych",
  "license": "MIT",
  "author": "whitekali",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build && rm -f .next/standalone/.env && cp -r .next/static .next/standalone/.next/static/ && cp -r public .next/standalone/public/",
    "start": "node -r dotenv/config .next/standalone/server.js",
    "lint": "eslint src/ --fix",
    "lint:check": "eslint src/",
    "typecheck": "tsc --noEmit",
    "watch": "node scripts/watch-lint.js",
    "setup:admin": "node scripts/setup-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-auth": "^4.24.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.6",
    "chokidar": "^4.0.3",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.6.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
