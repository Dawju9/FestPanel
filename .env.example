# FestPanel - Admin Dashboard Configuration
# Copy this file to .env and fill in your values

# Admin login credentials
ADMIN_USER=whitekali

# Bcrypt hash of your password (generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))")
# Password must be at least 7 characters with numbers and symbols
ADMIN_HASH=

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Google reCAPTCHA Enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfyfAotAAAAACPIpObjdVcmIgvBMGfueHuRIBQd
RECAPTCHA_PROJECT_ID=
# If you need credentials, set GOOGLE_APPLICATION_CREDENTIALS path
GOOGLE_APPLICATION_CREDENTIALS=

# Database connection
MONGODB_URI=

# NextAuth URL (set to your production URL when deployed)
NEXTAUTH_URL=http://localhost:3099